<Page x:Class="NekoVRC.WinUI.Views.WaveformsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Page.Resources>
  <Style x:Key="HistogramBarStyle" TargetType="Rectangle">
   <Setter Property="Fill" Value="{ThemeResource AccentFillColorDefaultBrush}"/>
   <Setter Property="RadiusX" Value="1"/><Setter Property="RadiusY" Value="1"/>
  </Style>
 </Page.Resources>
 <Grid RowSpacing="8">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="160"/></Grid.RowDefinitions>
  <StackPanel Spacing="6">
   <Grid ColumnSpacing="8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ComboBox x:Name="KindBox" Width="120" HorizontalAlignment="Left" SelectionChanged="KindChanged" AutomationProperties.Name="波形设备类型">
     <ComboBoxItem Content="郊狼波形" Tag="coyote"/><ComboBoxItem Content="负鼠波形" Tag="opossum"/>
    </ComboBox>
    <Button x:Name="ImportFileButton" Grid.Column="1" Content="导入文件 / ZIP" Click="ImportFiles"/>
    <Button x:Name="ImportFolderButton" Grid.Column="2" Content="导入文件夹" Click="ImportFolder"/>
   </Grid>
   <TextBlock x:Name="FormatHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
   <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True"/>
  </StackPanel>
  <!-- Headings and lists share the same columns, including the transfer
       buttons' Auto width. Separate grids would split the star columns
       differently and shift the right heading by half the buttons' width. -->
  <Grid x:Name="WaveformLists" Grid.Row="1" ColumnSpacing="8" RowSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock x:Name="LibraryHeading" Text="波形库" VerticalAlignment="Center"/>
   <TextBlock x:Name="EnabledHeading" Grid.Column="2" Text="波形选择框" VerticalAlignment="Center"/>
   <Border x:Name="LibraryContainer" Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
    <ListView x:Name="LibraryList" SelectionMode="Extended" CanDragItems="True" AllowDrop="True"
     DragItemsStarting="WaveDragStarting" DragOver="DragOverList" Drop="DropOnList" SelectionChanged="SelectionChanged" AutomationProperties.Name="未加入选择框的波形">
     <ListView.ItemTemplate><DataTemplate>
      <StackPanel Margin="0,2"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
     </DataTemplate></ListView.ItemTemplate>
    </ListView>
   </Border>
   <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Spacing="8">
    <Button Content="&#xE76C;" FontFamily="Segoe Fluent Icons" Click="AddSelected" AutomationProperties.Name="加入选择框" ToolTipService.ToolTip="加入选择框"/>
    <Button Content="&#xE76B;" FontFamily="Segoe Fluent Icons" Click="RemoveSelected" AutomationProperties.Name="移出选择框" ToolTipService.ToolTip="移出选择框"/>
   </StackPanel>
   <Border x:Name="EnabledContainer" Grid.Row="1" Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
    <ListView x:Name="EnabledList" SelectionMode="Extended" CanDragItems="True" CanReorderItems="True" AllowDrop="True"
     DragItemsStarting="WaveDragStarting" DragItemsCompleted="ReorderCompleted" DragOver="DragOverList" Drop="DropOnList" SelectionChanged="SelectionChanged" AutomationProperties.Name="通道可选波形，支持拖动排序">
     <ListView.ItemTemplate><DataTemplate>
      <StackPanel Margin="0,2"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
     </DataTemplate></ListView.ItemTemplate>
    </ListView>
   </Border>
  </Grid>
  <Border x:Name="PreviewCard" Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6">
   <Grid RowSpacing="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="PreviewTitle" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
     <ToggleButton x:Name="PreviewPlayback" Grid.Column="1" IsChecked="True" IsEnabled="False" Click="TogglePreviewPlayback" Width="28" Height="24" MinWidth="0" MinHeight="0" Padding="0" AutomationProperties.Name="暂停预览">
      <FontIcon x:Name="PreviewPlaybackIcon" Glyph="&#xE769;" FontSize="12"/>
     </ToggleButton>
    </Grid>
    <Grid x:Name="PreviewArea" Grid.Row="1" SizeChanged="PreviewSizeChanged">
     <Canvas x:Name="PreviewCanvas" SizeChanged="PreviewSizeChanged" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False" AutomationProperties.Name="幅值与频率联合动态预览"/>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</Page>

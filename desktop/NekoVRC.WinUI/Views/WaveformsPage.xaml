<Page x:Class="NekoVRC.WinUI.Views.WaveformsPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid RowSpacing="8">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="132"/></Grid.RowDefinitions>
  <StackPanel Spacing="6">
   <Grid ColumnSpacing="8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ComboBox x:Name="KindBox" Width="120" HorizontalAlignment="Left" SelectionChanged="KindChanged" AutomationProperties.Name="波形设备类型">
     <ComboBoxItem Content="郊狼波形" Tag="coyote"/><ComboBoxItem Content="负鼠波形" Tag="opossum"/>
    </ComboBox>
    <Button x:Name="ImportFileButton" Grid.Column="1" Content="导入文件 / ZIP" Click="ImportFiles"/>
    <Button x:Name="ImportFolderButton" Grid.Column="2" Content="导入文件夹" Click="ImportFolder"/>
   </Grid>
   <TextBlock x:Name="FormatHint" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
   <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True"/>
  </StackPanel>
  <Grid Grid.Row="1" ColumnSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock Text="波形库" VerticalAlignment="Center"/>
   <TextBlock Grid.Column="2" Text="通道选择框 · 拖动排序" VerticalAlignment="Center"/>
  </Grid>
  <Grid Grid.Row="2" ColumnSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
    <ListView x:Name="LibraryList" SelectionMode="Extended" CanDragItems="True" AllowDrop="True"
     DragItemsStarting="WaveDragStarting" DragOver="DragOverList" Drop="DropOnList" SelectionChanged="SelectionChanged" AutomationProperties.Name="未加入选择框的波形">
     <ListView.ItemTemplate><DataTemplate>
      <StackPanel Margin="0,2"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
     </DataTemplate></ListView.ItemTemplate>
    </ListView>
   </Border>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
    <Button Content="&#xE76C;" FontFamily="Segoe Fluent Icons" Click="AddSelected" AutomationProperties.Name="加入选择框" ToolTipService.ToolTip="加入选择框"/>
    <Button Content="&#xE76B;" FontFamily="Segoe Fluent Icons" Click="RemoveSelected" AutomationProperties.Name="移出选择框" ToolTipService.ToolTip="移出选择框"/>
   </StackPanel>
   <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
    <ListView x:Name="EnabledList" SelectionMode="Extended" CanDragItems="True" CanReorderItems="True" AllowDrop="True"
     DragItemsStarting="WaveDragStarting" DragItemsCompleted="ReorderCompleted" DragOver="DragOverList" Drop="DropOnList" SelectionChanged="SelectionChanged" AutomationProperties.Name="通道可选波形，支持拖动排序">
     <ListView.ItemTemplate><DataTemplate>
      <StackPanel Margin="0,2"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
     </DataTemplate></ListView.ItemTemplate>
    </ListView>
   </Border>
  </Grid>
  <Border Grid.Row="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6">
   <Grid RowSpacing="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="PreviewTitle" Text="选择波形以预览" TextTrimming="CharacterEllipsis"/>
    <Grid x:Name="PreviewArea" Grid.Row="1" SizeChanged="PreviewSizeChanged">
     <Canvas x:Name="PreviewCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Polyline x:Name="PreviewLine" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="1.5"/>
     </Canvas>
    </Grid>
    <TextBlock Grid.Row="2" Text="幅值 0–100% · 预览不启动设备 · Ctrl / Shift 多选" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   </Grid>
  </Border>
 </Grid>
</Page>

<Page x:Class="NekoVRC.WinUI.Views.GeneralPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
 <ScrollViewer Tag="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Spacing="6">
   <toolkit:SettingsCard Header="外观" MinHeight="52" Padding="12,8">
    <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;"/></toolkit:SettingsCard.HeaderIcon>
    <ComboBox ItemsSource="{Binding ThemeChoices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Theme, Mode=TwoWay}" Width="160" AutomationProperties.Name="外观模式"/>
   </toolkit:SettingsCard>
   <toolkit:SettingsCard Header="设备连接" Description="无需 OSC 分流，在郊狼和负鼠页面分别选择 App 或蓝牙直连" MinHeight="52" Padding="12,8">
    <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Link"/></toolkit:SettingsCard.HeaderIcon>
    <Button Content="App 扫码连接" Command="{Binding QrCommand}"/>
   </toolkit:SettingsCard>
   <toolkit:SettingsCard Header="波形库" Description="导入、预览与整理可选波形" IsClickEnabled="True" Command="{Binding WaveformsCommand}" ActionIconToolTip="打开波形库" MinHeight="52" Padding="12,8" AutomationProperties.Name="打开波形库">
    <toolkit:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9D9;"/></toolkit:SettingsCard.HeaderIcon>
   </toolkit:SettingsCard>
   <toolkit:SettingsCard Header="Chatbox" Description="游戏中聊天框显示设备强度上限" MinHeight="52" Padding="12,8">
    <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Message"/></toolkit:SettingsCard.HeaderIcon>
    <ToggleSwitch IsOn="{Binding Chatbox, Mode=TwoWay}" AutomationProperties.Name="启用 Chatbox"/>
   </toolkit:SettingsCard>
   <toolkit:SettingsCard Header="关闭窗口后在托盘运行" MinHeight="52" Padding="12,8">
    <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="BackToWindow"/></toolkit:SettingsCard.HeaderIcon>
    <ToggleSwitch IsOn="{Binding Background, Mode=TwoWay}" AutomationProperties.Name="关闭窗口后在托盘运行"/>
   </toolkit:SettingsCard>
   <toolkit:SettingsCard Header="跟随 SteamVR 启动" MinHeight="52" Padding="12,8">
    <toolkit:SettingsCard.HeaderIcon><SymbolIcon Symbol="Play"/></toolkit:SettingsCard.HeaderIcon>
    <ToggleSwitch IsOn="{Binding SteamVR, Mode=TwoWay}" AutomationProperties.Name="跟随 SteamVR 启动"/>
   </toolkit:SettingsCard>
   <toolkit:SettingsCard Header="配置位置" HorizontalContentAlignment="Stretch" ContentAlignment="Vertical" MinHeight="52" Padding="12,8">
    <TextBlock Text="{Binding ConfigPath}" IsTextSelectionEnabled="True" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   </toolkit:SettingsCard>
  </StackPanel>
 </ScrollViewer>
</Page>

<Page x:Class="NekoVRC.WinUI.Views.AboutPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">
 <ScrollViewer Tag="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Spacing="6">
   <toolkit:SettingsCard Header="Neko-VRC" Description="VRChat OSC · 郊狼 / 负鼠 · QQ交流群 1130363303" MinHeight="52" Padding="12,8">
    <TextBlock Text="v2.0.1"/>
   </toolkit:SettingsCard>
   <TextBlock Text="相关来源" Margin="0,4,0,4"/>
   <ItemsControl ItemsSource="{Binding Credits}"><ItemsControl.ItemTemplate><DataTemplate>
    <toolkit:SettingsCard Header="{Binding Name}" Description="{Binding Url}" Margin="0,0,0,4" MinHeight="52" Padding="12,8">
     <HyperlinkButton Content="打开" NavigateUri="{Binding Url}"/>
    </toolkit:SettingsCard>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="开源许可：GNU Affero General Public License v3.0" Style="{StaticResource CaptionTextBlockStyle}"/>
   <TextBlock Text="DG-LAB、VRChat、SteamVR 等名称及商标归各自权利人所有。" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/>
  </StackPanel>
 </ScrollViewer>
</Page>

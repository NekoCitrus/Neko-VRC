<Window x:Class="NekoVRC.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:NekoVRC.Desktop"
 Style="{StaticResource {x:Type Window}}"
 Title="Neko-VRC" Width="1120" Height="860" MinWidth="960" MinHeight="800"
 WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid Margin="16,16,24,16">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Grid.RowSpan="2" Margin="0,0,0,4">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Neko-VRC" FontSize="20" FontWeight="SemiBold" Margin="16,8,0,24"/>
    <StackPanel Grid.Row="1">
     <RadioButton Style="{StaticResource NavigationItem}" IsChecked="{Binding IsGeneral, Mode=OneWay}" Command="{Binding PageCommand}" CommandParameter="general" AutomationProperties.Name="基本设置">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,12,0"/><TextBlock Text="基本设置"/></StackPanel>
     </RadioButton>
     <RadioButton Style="{StaticResource NavigationItem}" IsChecked="{Binding IsCoyote, Mode=OneWay}" Command="{Binding PageCommand}" CommandParameter="coyote" AutomationProperties.Name="郊狼">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE772;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,12,0"/><TextBlock Text="郊狼"/></StackPanel>
     </RadioButton>
     <RadioButton Style="{StaticResource NavigationItem}" IsChecked="{Binding IsOpossum, Mode=OneWay}" Command="{Binding PageCommand}" CommandParameter="opossum" AutomationProperties.Name="负鼠">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE95E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,12,0"/><TextBlock Text="负鼠"/></StackPanel>
     </RadioButton>
     <RadioButton Style="{StaticResource NavigationItem}" IsChecked="{Binding IsDebug, Mode=OneWay}" Command="{Binding PageCommand}" CommandParameter="debug" AutomationProperties.Name="运行调试">
      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,12,0"/><TextBlock Text="运行调试"/></StackPanel>
     </RadioButton>
    </StackPanel>
    <RadioButton Grid.Row="2" Style="{StaticResource NavigationItem}" IsChecked="{Binding IsAbout, Mode=OneWay}" Command="{Binding PageCommand}" CommandParameter="about" AutomationProperties.Name="关于与版权">
     <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,12,0"/><TextBlock Text="关于与版权"/></StackPanel>
    </RadioButton>
   </Grid>
   <Grid x:Name="PageArea" Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding Avatar}" Style="{StaticResource SecondaryText}" Margin="0,4,0,12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Avatar}"/>
    <StackPanel Grid.Row="1" Visibility="{Binding IsGeneral, Converter={StaticResource Visible}}">
     <TextBlock Text="基本设置" FontSize="26" Margin="0,0,0,16"/>
     <Border Style="{StaticResource SettingsCard}">
      <StackPanel>
       <TextBlock Text="无需 OSC 分流软件。在郊狼和负鼠页面分别选择 App 或蓝牙直连。" Margin="0,0,0,12"/>
       <TextBlock Text=""/>
       <Button Content="App 扫码连接" Command="{Binding QrCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource SettingsCard}">
      <StackPanel>
       <Grid Margin="0,4,0,12"><TextBlock Text="Chatbox"/><CheckBox IsChecked="{Binding Chatbox}" HorizontalAlignment="Right" AutomationProperties.Name="启用 Chatbox"/></Grid>
       <Grid Margin="0,0,0,12"><TextBlock Text="关闭窗口后在托盘运行"/><CheckBox IsChecked="{Binding Background}" HorizontalAlignment="Right" AutomationProperties.Name="关闭窗口后在托盘运行"/></Grid>
       <Grid><TextBlock Text="跟随 SteamVR 启动"/><CheckBox IsChecked="{Binding SteamVR}" HorizontalAlignment="Right" AutomationProperties.Name="跟随 SteamVR 启动"/></Grid>
       <TextBlock Text="{Binding ConfigPath}" Style="{StaticResource SecondaryText}" Margin="0,14,0,0"/>
      </StackPanel>
     </Border>
    </StackPanel>
    <local:DeviceView Grid.Row="1" DataContext="{Binding CurrentDevice}" Visibility="{Binding DataContext.IsDevice, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}"/>
    <Grid Grid.Row="1" Visibility="{Binding IsDebug, Converter={StaticResource Visible}}">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="140"/></Grid.RowDefinitions>
     <TextBlock Text="运行调试" FontSize="26" Margin="0,0,0,12"/>
     <ItemsControl Grid.Row="1" ItemsSource="{Binding Devices}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border Style="{StaticResource SettingsCard}" Padding="16,12" Margin="0,0,0,10">
        <StackPanel>
         <TextBlock Text="{Binding Name}" FontSize="20"/>
         <TextBlock Text="{Binding Status}" Margin="0,4,0,4"/>
         <ItemsControl ItemsSource="{Binding Channels}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
          <StackPanel Margin="0,4,10,4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Debug}" FontSize="12" Margin="0,2,0,0"/></StackPanel>
         </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBox Grid.Row="2" Text="{Binding Logs, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
    </Grid>
    <StackPanel Grid.Row="1" Visibility="{Binding IsAbout, Converter={StaticResource Visible}}">
     <TextBlock Text="Neko-VRC" FontSize="26" Margin="0,0,0,8"/>
     <TextBlock Text="VRChat OSC · 郊狼 / 负鼠" Margin="0,0,0,16"/>
     <TextBlock Text="原始项目：Shocking-VRChat · Chatbox 来源：DG-LAB-VRCOSC" Margin="0,0,0,8" FontSize="12"/>
     <TextBlock Text="前端贡献：WenX1ang · 猫橘Citrus · ChatGPT" Margin="0,0,0,12"/>
     <ItemsControl ItemsSource="{Binding Credits}"><ItemsControl.ItemTemplate><DataTemplate>
      <Grid Margin="0,0,0,10">
       <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Name}"/>
       <TextBlock Grid.Column="1"><Hyperlink NavigateUri="{Binding Url}" RequestNavigate="OpenCredit"><Run Text="{Binding Url}"/></Hyperlink></TextBlock>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="开源许可：GNU Affero General Public License v3.0" Margin="0,8,0,4" FontSize="12"/>
     <TextBlock Text="DG-LAB、VRChat、SteamVR 等名称及商标归各自权利人所有。" FontSize="12"/>
    </StackPanel>
   </Grid>
   <Border Grid.Row="1" Grid.Column="2" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,10,0,0">
    <StackPanel>
     <TextBlock Text="{Binding Status}" Margin="0,0,0,8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
     <WrapPanel>
      <Button Content="保存并应用" Command="{Binding SaveCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0" Padding="14,6"/>
      <Button Content="急停" Command="{Binding StopCommand}" Foreground="#B42318" Margin="0,0,8,0"/>
      <Button Content="恢复" Command="{Binding ResumeCommand}" Margin="0,0,8,0"/>
      <Button Content="退出" Click="ExitApp" Margin="0"/>
     </WrapPanel>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
